rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function familyMember(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function isApproved(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
        && familyMember(familyId).data.status == 'approved';
    }

    function isAdmin(familyId) {
      return isApproved(familyId)
        && familyMember(familyId).data.role == 'admin';
    }

    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function validOptionalText(value, max) {
      return value is string && value.size() <= max;
    }

    function validAudit(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0;
    }

    match /families/{familyId} {
      allow read, write: if false;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isApproved(familyId));

        // One-time bootstrap: only the designated Google account can create
        // its own approved admin membership. No other client can self-promote.
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.auth.token.email == 'jatoy0a11@gmail.com'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'approved'
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'status', 'createdAt', 'updatedAt']);

        allow create, update, delete: if isAdmin(familyId);

        // Transport choices are personal, location-adjacent data. Even family
        // administrators may not access another member's preferences.
        match /transport/{preferenceId} {
          function isPreferenceOwner() {
            return preferenceId == 'preferences'
              && signedIn()
              && request.auth.uid == uid
              && isApproved(familyId);
          }

          function validTransportPreference(data) {
            return data.keys().hasOnly(['schemaVersion', 'revision', 'interval', 'showOnHome', 'createdAt', 'updatedAt'])
              && data.schemaVersion == 1
              && data.revision is int
              && data.revision > 0
              && data.interval in [0, 15, 30, 60]
              && data.showOnHome is bool
              && data.createdAt is timestamp
              && data.updatedAt is timestamp;
          }

          function validOrder(value) {
            return value is int && value >= 0 && value < 36;
          }

          function validTransportText(value, max) {
            return value is string && value.size() > 0 && value.size() <= max;
          }

          function validTransportDisplayText(value, max) {
            return value is string && value.size() <= max;
          }

          function validRoute(item) {
            return item is map
              && item.keys().hasOnly(['id', 'operator', 'route', 'routeId', 'direction', 'serviceType', 'stopId', 'stopName', 'destination', 'order'])
              && validTransportText(item.id, 120)
              && item.operator in ['KMB', 'LWB', 'CTB', 'GMB']
              && validTransportText(item.route, 20)
              && (item.operator == 'GMB'
                ? ('routeId' in item && validTransportText(item.routeId, 120))
                : (!('routeId' in item) || item.routeId == ''))
              && (item.operator == 'GMB' ? item.direction in ['1', '2'] : item.direction in ['I', 'O'])
              && validTransportDisplayText(item.serviceType, 20)
              && validTransportText(item.stopId, 120)
              && validTransportDisplayText(item.stopName, 120)
              && validTransportDisplayText(item.destination, 120)
              && validOrder(item.order);
          }

          function validStop(item) {
            return item is map
              && item.keys().hasOnly(['id', 'operator', 'stopId', 'stopName', 'routes', 'order'])
              && validTransportText(item.id, 120)
              && item.operator in ['KMB', 'LWB', 'CTB', 'GMB']
              && validTransportText(item.stopId, 120)
              && validTransportDisplayText(item.stopName, 120)
              && validRouteNames(item.routes)
              && validOrder(item.order);
          }

          function validRouteNames(items) {
            return items is list && items.size() <= 12
              && (items.size() < 1 || validTransportText(items[0], 120))
              && (items.size() < 2 || validTransportText(items[1], 120))
              && (items.size() < 3 || validTransportText(items[2], 120))
              && (items.size() < 4 || validTransportText(items[3], 120))
              && (items.size() < 5 || validTransportText(items[4], 120))
              && (items.size() < 6 || validTransportText(items[5], 120))
              && (items.size() < 7 || validTransportText(items[6], 120))
              && (items.size() < 8 || validTransportText(items[7], 120))
              && (items.size() < 9 || validTransportText(items[8], 120))
              && (items.size() < 10 || validTransportText(items[9], 120))
              && (items.size() < 11 || validTransportText(items[10], 120))
              && (items.size() < 12 || validTransportText(items[11], 120));
          }

          function validMtr(item) {
            return item is map
              && item.keys().hasOnly(['id', 'line', 'station', 'direction', 'destination', 'order'])
              && validTransportText(item.id, 120)
              && item.line in ['AEL', 'TCL', 'TML', 'TKL', 'EAL', 'SIL', 'TWL', 'ISL', 'KTL', 'DRL']
              && validTransportText(item.station, 20)
              && item.direction in ['UP', 'DOWN']
              && validTransportDisplayText(item.destination, 120)
              && validOrder(item.order);
          }

          allow read, delete: if isPreferenceOwner();
          allow create: if isPreferenceOwner()
            && validTransportPreference(request.resource.data)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if isPreferenceOwner()
            && validTransportPreference(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.updatedAt == request.time;

          match /routes/{entryId} {
            allow read, delete: if isPreferenceOwner();
            allow create, update: if isPreferenceOwner()
              && request.resource.data.id == entryId
              && validRoute(request.resource.data);
          }

          match /stops/{entryId} {
            allow read, delete: if isPreferenceOwner();
            allow create, update: if isPreferenceOwner()
              && request.resource.data.id == entryId
              && validStop(request.resource.data);
          }

          match /mtr/{entryId} {
            allow read, delete: if isPreferenceOwner();
            allow create, update: if isPreferenceOwner()
              && request.resource.data.id == entryId
              && validMtr(request.resource.data);
          }
        }
      }

      match /membershipRequests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin(familyId));
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'status', 'createdAt', 'updatedAt']);
        allow delete: if isAdmin(familyId) || (signedIn() && request.auth.uid == uid);
        allow update: if isAdmin(familyId);
      }

      match /announcements/{announcementId} {
        // Announcements are intentionally public so visitors can read them
        // before signing in. Only an approved family admin may publish/delete.
        allow read: if true;
        allow create: if isAdmin(familyId)
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 280;
        allow update: if false;
        allow delete: if isAdmin(familyId);
      }

      match /todos/{itemId} {
        allow read, delete: if isApproved(familyId);
        allow create, update: if isApproved(familyId)
          && request.resource.data.keys().hasOnly(['title', 'category', 'completed', 'createdBy', 'createdAt', 'updatedAt'])
          && validText(request.resource.data.title, 200)
          && request.resource.data.category in ['todo', 'shopping']
          && request.resource.data.completed is bool
          && validAudit(request.resource.data);
      }

      match /calendarEvents/{eventId} {
        allow read, delete: if isApproved(familyId);
        allow create, update: if isApproved(familyId)
          && request.resource.data.keys().hasOnly(['title', 'date', 'time', 'category', 'repeat', 'createdBy', 'createdAt', 'updatedAt'])
          && validText(request.resource.data.title, 200)
          && validText(request.resource.data.date, 10)
          && validOptionalText(request.resource.data.time, 5)
          && request.resource.data.category in ['family', 'school', 'medical', 'car', 'bill', 'birthday', 'other']
          && request.resource.data.repeat in ['none', 'weekly', 'monthly', 'yearly']
          && validAudit(request.resource.data);
      }

      match /usefulInfo/{infoId} {
        allow read, delete: if isApproved(familyId);
        allow create, update: if isApproved(familyId)
          && request.resource.data.keys().hasOnly(['category', 'name', 'phone', 'address', 'note', 'sortOrder', 'createdAt', 'updatedAt'])
          && request.resource.data.category in ['estate', 'medical', 'company', 'emergency', 'other']
          && validText(request.resource.data.name, 120)
          && validOptionalText(request.resource.data.phone, 80)
          && validOptionalText(request.resource.data.address, 500)
          && validOptionalText(request.resource.data.note, 1000)
          && request.resource.data.sortOrder is number
          && request.resource.data.sortOrder >= 0
          && request.resource.data.sortOrder <= 100000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      match /notes/{noteId} {
        allow read, delete: if isApproved(familyId);
        allow create, update: if isApproved(familyId)
          && request.resource.data.keys().hasOnly(['title', 'content', 'createdBy', 'createdAt', 'updatedAt'])
          && validText(request.resource.data.title, 200)
          && validOptionalText(request.resource.data.content, 5000)
          && validAudit(request.resource.data);
      }

      match /reminders/{reminderId} {
        allow read, delete: if isApproved(familyId);
        allow create, update: if isApproved(familyId)
          && request.resource.data.keys().hasOnly(['title', 'dueDate', 'repeat', 'leadDays', 'createdBy', 'createdAt', 'updatedAt'])
          && validText(request.resource.data.title, 200)
          && validText(request.resource.data.dueDate, 10)
          && request.resource.data.repeat in ['none', 'monthly', 'yearly']
          && request.resource.data.leadDays is int
          && request.resource.data.leadDays >= 0
          && request.resource.data.leadDays <= 365
          && validAudit(request.resource.data);
      }

      match /expenses/{expenseId} {
        allow read, delete: if isApproved(familyId);
        allow create, update: if isApproved(familyId)
          && request.resource.data.keys().hasOnly(['title', 'amountCents', 'currency', 'date', 'category', 'paidBy', 'note', 'createdBy', 'createdAt', 'updatedAt'])
          && validText(request.resource.data.title, 200)
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents >= 1
          && request.resource.data.amountCents <= 999999999
          && request.resource.data.currency == 'HKD'
          && validText(request.resource.data.date, 10)
          && request.resource.data.category in ['groceries', 'dining', 'transport', 'home', 'utilities', 'health', 'education', 'leisure', 'other']
          && validOptionalText(request.resource.data.paidBy, 80)
          && validOptionalText(request.resource.data.note, 1000)
          && validAudit(request.resource.data);
      }
    }
  }
}
